# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
SOURCE_DB_NAME=vectadb
SOURCE_COLLECTION_NAME=ai_targets
DESTINATION_DB_NAME=log_samples
TRACKING_DB_NAME=loggingtracker
TRACKING_COLLECTION_NAME=logging_tracks

# ── Sampling behavior ─────────────────────────────────────────────────────────
# SAMPLE_MODE: head | tail | both
SAMPLE_MODE=both
# Lines captured per file (can be overridden per-target in the UI)
SAMPLE_LINE_COUNT=50

# ── Service execution ─────────────────────────────────────────────────────────
# RUN_MODE: once | periodic
RUN_MODE=periodic
POLL_INTERVAL_SECS=300
CONCURRENCY=4
SSH_TIMEOUT_SECS=15

# ── REST API ──────────────────────────────────────────────────────────────────
API_PORT=8080

# ── Prometheus metrics ────────────────────────────────────────────────────────
METRICS_PORT=9090

# ── Remote file discovery ─────────────────────────────────────────────────────
REMOTE_MAX_DEPTH=3
# Max files per target directory (can be overridden per-target in the UI)
REMOTE_MAX_FILES_PER_TARGET=100
REMOTE_FIND_PATTERNS=*.log,*.out,*.txt

# ── Preprocessing pipeline ────────────────────────────────────────────────────
PREPROCESSING_ENABLED=true
PREPROCESSING_AGENTIC_THRESHOLD=0.02
PREPROCESSING_MAX_SCHEMA_LINES=200
# When true, DELETE metadata documents whose preprocessing_version differs from
# this binary's on startup, so the next cycle regenerates them. Off by default —
# it discards derived data. Also reachable as `backfill --reprocess_stale`.
PREPROCESSING_REPROCESS_ON_VERSION_CHANGE=false

# ── UpsideGate (Stages 6–10: entity extraction, semantic roles, relations, ──
#    PROV-O triples, OTel spans).  Master kill-switch for the new pipeline. ──
ENTITY_EXTRACTION_ENABLED=true
# Skip the async output adapters when fewer than this many entities are
# extracted from a sample (saves DB round-trips on sparse logs).  Set to 0
# to write for every sample with ≥1 entity.
ENTITY_EXTRACTION_MIN_ENTITIES=1

# ── Stage 11: task correlation ───────────────────────────────────────────────
# Groups samples into tasks by a correlation key found in the log itself
# (task_id > run_id > session_id > conversation_id > thread_id > crew_id >
# request_id), so a task spanning several samples reassembles into one. Writes
# the `tasks` collection, which is the index for task-scoped search.
#
# Logs carrying no such key fall back to one task per sample — recorded as
# task_id_source="sample" so an audit can tell a real boundary from a fallback.
#
# Purely additive: trace_id, span ids, entity ids and relation ids are unchanged.
# Off by default because it starts writing a new collection.
TASK_CORRELATION_ENABLED=false

# ── Stage 12: actor nodes ────────────────────────────────────────────────────
# Promotes the participants buried in event attributes — model_id, tool_name,
# mcp_server_id — into their own nodes in the `actors` collection, with
# PERFORMED_BY / USED_SKILL / ACCESSED_RESOURCE edges from the events that
# involved them. Makes "which agents used this skill" a traversal rather than a
# scan, across samples: one `web_search` node, however many samples it appears in.
#
# Unlike task correlation this adds *edges*, so enabling it changes what an
# existing graph traversal returns. Off by default.
ACTOR_NODES_ENABLED=false

# ── UpsideGate output adapters (Phase 6) ─────────────────────────────────────
# Persists relation edges, PROV triples, and OTel spans to MongoDB
# collections (entity_edges, prov_relations, otel_spans).  Independent of the
# vector writer.
GRAPH_WRITER_ENABLED=false
GRAPH_WRITER_BACKEND=mongodb

# Persists content + behavioral embeddings to MongoDB collections
# (content_embeddings, behavioral_embeddings).  Independent of the graph
# writer.  Behavioral embeddings are computed locally; content embeddings
# require EMBEDDING_ENABLED=true and a valid API key.
VECTOR_WRITER_ENABLED=false
VECTOR_WRITER_BACKEND=mongodb

# ── Embedding worker (Phase 5) ───────────────────────────────────────────────
# Toggling this on requires an OpenAI-compatible embeddings endpoint.
# Behavioral embeddings (35-dim local feature vector) are always computed
# when the worker is built — only content embeddings depend on this flag.
EMBEDDING_ENABLED=false
EMBEDDING_API_KEY=
EMBEDDING_API_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_MAX_TEXT_CHARS=8000
EMBEDDING_DIMENSIONS=1536

# ── LLM Classification ───────────────────────────────────────────────────────
CLASSIFICATION_ENABLED=false
ANTHROPIC_API_KEY=sk-ant-...
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
CLASSIFICATION_SIGNAL_THRESHOLD=0.05
CLASSIFICATION_MAX_PER_CYCLE=10
CLASSIFICATION_MAX_OUTPUT_TOKENS=1024
# API format: "anthropic" (default) or "openai" (any OpenAI-compatible provider)
CLASSIFICATION_API_FORMAT=anthropic
# Base URL — leave empty to use provider default. Examples:
#   http://localhost:11434   → Ollama
#   https://openrouter.ai/api → OpenRouter
#   https://api.groq.com/openai → Groq
CLASSIFICATION_API_BASE_URL=

# ── Notifications / alerting ─────────────────────────────────────────────────
# Set NOTIFICATION_ENABLED=true and configure at least one destination.
NOTIFICATION_ENABLED=false
# Minimum severity to trigger a notification: normal | info | warning | critical
NOTIFICATION_SEVERITY_THRESHOLD=critical
# Slack incoming-webhook URL (leave empty to skip Slack)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# Generic HTTP endpoint — receives a JSON POST with the full classification (leave empty to skip)
WEBHOOK_URL=https://your-endpoint.example.com/logflayer
# Optional shared secret for HMAC-SHA256 payload signing (X-Logflayer-Signature header)
WEBHOOK_SECRET=your-secret-here

# ── Configuration history ────────────────────────────────────────────────────
# Stores full recoverable admin-setting snapshots. Secret fields are encrypted
# when history is enabled, so CONFIG_HISTORY_MASTER_KEY must be set outside MongoDB.
# Use a base64-encoded 32-byte key, or exactly 32 raw bytes.
CONFIG_HISTORY_ENABLED=false
CONFIG_HISTORY_MASTER_KEY=
CONFIG_HISTORY_KEY_ID=logflayer-config-v1
CONFIG_HISTORY_COLLECTION_NAME=app_settings_history

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIRECTORY=./logs
LOG_FILE_BASE_NAME=logflayer
LOG_MAX_FILE_SIZE_BYTES=10485760
LOG_MAX_FILES=10

# ── Docker UI port ────────────────────────────────────────────────────────────
UI_PORT=3000
